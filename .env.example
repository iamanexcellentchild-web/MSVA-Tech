# Copy this file to `.env` and fill in the values. Never commit `.env`.

# --- Django ---
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# In production, e.g.: https://msvirtualacademy.com
DJANGO_CSRF_TRUSTED_ORIGINS=

# --- Database ---
# Leave blank to use SQLite (db.sqlite3). In production, a Postgres URL, e.g.
# postgresql://user:password@host/dbname?sslmode=require
DATABASE_URL=

# --- Uploads (optional) ---
# cloudinary://<api_key>:<api_secret>@<cloud_name>  (from the Cloudinary dashboard)
# Leave blank to store uploads in the local media/ folder.
CLOUDINARY_URL=

# --- Google OAuth 2.0 (https://console.cloud.google.com/apis/credentials) ---
# Create an "OAuth client ID" of type "Web application" and add this
# Authorized redirect URI: http://localhost:8000/accounts/google/callback/
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Optional; leave blank to derive it from the current host.
GOOGLE_OAUTH_REDIRECT_URI=

# --- JWT lifetimes ---
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Email: Brevo (free plan, 300 emails/day; works on Render's free plan) ---
# Render's free plan blocks SMTP, so the live site sends through Brevo's HTTPS API.
# 1. brevo.com -> sign up -> Senders, Domains & Dedicated IPs -> verify the sender address below.
# 2. SMTP & API -> API Keys -> Generate a new API key (starts with "xkeysib-").
# 3. Settings -> Security -> Authorized IPs: add Render's outbound IPs (Render -> service -> Connect -> Outbound).
BREVO_API_KEY=
DEFAULT_FROM_EMAIL=MS. Virtual Academy <ms.virtualacademy247@gmail.com>
# Where contact-form messages are delivered.
CONTACT_INBOX=ms.virtualacademy247@gmail.com

# --- Email: Gmail SMTP (alternative for hosts that allow SMTP; NOT Render's free plan) ---
# Only used when BREVO_API_KEY is empty. Needs a Gmail App Password
# (https://myaccount.google.com/apppasswords), not your normal password.
# Leave all email settings blank during development to print emails in the terminal instead.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
